<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <ScrollView
        android:id="@+id/sidebar_scroll"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:background="#20000000"
        android:padding="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/_background_display_view"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/share_logs_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="@dimen/_52sdp"
                android:layout_height="@dimen/_42sdp"
                android:layout_marginBottom="6dp"
                android:gravity="center"
                android:padding="0dp"
                android:drawableStart="@drawable/ic_px_sharelog" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/news_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="@dimen/_52sdp"
                android:layout_height="@dimen/_42sdp"
                android:layout_marginBottom="6dp"
                android:gravity="center"
                android:padding="0dp"
                android:drawableStart="@drawable/ic_px_book" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/social_media_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="@dimen/_52sdp"
                android:layout_height="@dimen/_42sdp"
                android:gravity="center"
                android:padding="0dp"
                android:drawableStart="@drawable/ic_social_media" />

        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/sidebar_divider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="@color/icon_outline_color"
        app:layout_constraintStart_toEndOf="@id/sidebar_scroll"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/_background_display_view" />

    <GridLayout
        android:id="@+id/button_grid_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/sidebar_divider">

        <LinearLayout
            android:id="@+id/center_instance_box"
            android:layout_width="260dp"
            android:layout_height="@dimen/_48sdp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:layout_margin="6dp"
            android:background="@drawable/border_outline">

            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:drawableEnd="@drawable/spinner_arrow"
                app:drawableEndPadding="@dimen/_1sdp"
                app:drawableEndSize="@dimen/_12sdp"
                app:drawableStartIntegerScaling="true"
                app:drawableStartSize="@dimen/_36sdp" />

            <ImageButton
                android:id="@+id/edit_profile_button"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@drawable/ic_px_edit" />
        </LinearLayout>

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/custom_control_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="260dp"
            android:layout_height="@dimen/_48sdp"
            android:layout_margin="6dp"
            android:gravity="center_vertical|start"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Custom Control"
            android:textColor="#FFFFFF"
            android:background="@drawable/border_outline"
            android:drawableStart="@drawable/ic_px_gamepad"
            android:drawablePadding="8dp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/install_jar_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="260dp"
            android:layout_height="@dimen/_48sdp"
            android:layout_margin="6dp"
            android:gravity="center_vertical|start"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Execute (.jar)"
            android:textColor="#FFFFFF"
            android:background="@drawable/border_outline"
            android:drawableStart="@drawable/ic_px_java_run"
            android:drawablePadding="8dp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/open_files_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="260dp"
            android:layout_height="@dimen/_48sdp"
            android:layout_margin="6dp"
            android:gravity="center_vertical|start"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Game Path"
            android:textColor="#FFFFFF"
            android:background="@drawable/border_outline"
            android:drawableStart="@drawable/ic_px_folder"
            android:drawablePadding="8dp" />

    </GridLayout>

    <View
        android:id="@+id/_background_display_view"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/background_bottom_bar"
        android:translationZ="-1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

        <com.kdt.mcgui.MineButton
        android:id="@+id/play_button"
        android:layout_width="140dp"
        android:layout_height="46dp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:layout_marginBottom="5dp"
        android:text="@string/main_play"
        android:textAllCaps="true"
        android:textSize="18sp"
        android:textColor="#000000"
        android:background="@drawable/rounded_white_button"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/_background_display_view" />

</androidx.constraintlayout.widget.ConstraintLayout>
